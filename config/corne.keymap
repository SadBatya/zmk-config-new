/*
 * Python Developer Layout — Corne MX (Matvey Keyboard)
 *
 * Thumbs: [ GUI | SYM | Space ]   [ Enter | NAV | Del ]
 *
 * Layer 0: Base — QWERTY
 * Layer 1: SYM  — Python: _, :, (), [], {}, "", '', @, #, операторы
 * Layer 2: NAV  — Цифры, стрелки, F-клавиши
 * Layer 3: SYS  — Bluetooth (SYM + NAV одновременно)
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
// ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬──────╮
// │ TAB  │  Q  │  W  │  E  │  R  │  T  │   │  Y  │  U  │  I  │  O  │  P  │ BSPC │
// │ CTRL │  A  │  S  │  D  │  F  │  G  │   │  H  │  J  │  K  │  L  │  ;  │  '   │
// │ SHFT │  Z  │  X  │  C  │  V  │  B  │   │  N  │  M  │  ,  │  .  │  /  │ ESC  │
// ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┴──────╯
//                    │ GUI │ SYM │ SPC │   │ ENT │ NAV │ DEL │
//                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
            bindings = <
   &kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
   &kp LCTRL  &kp A  &kp S  &kp D  &kp F  &kp G    &kp H  &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
   &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B    &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp ESC
                          &kp LGUI  &mo 1  &kp SPACE    &kp RET  &mo 2  &kp DEL
            >;
        };

        sym_layer {
// Python symbols — оптимизировано для Python-разработчика
// ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬──────╮
// │  ~   │  !  │  @  │  #  │  $  │  %  │   │  ^  │  &  │  *  │  (  │  )  │ DEL  │
// │      │  `  │  {  │  }  │  [  │  ]  │   │  _  │  =  │  +  │  -  │  :  │  |   │
// │      │     │  \  │  "  │  '  │  @  │   │  /  │  ?  │  <  │  >  │  ;  │  ~   │
// ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┴──────╯
//                    │ GUI │ --- │ SPC │   │ ENT │ SYS │ DEL │
//                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
//
// _ и : на home row правой руки — snake_case, def/if/for/class, срезы, словари
// {}, [] на home row левой руки — dict literals, list, slice
// "", '' на нижнем ряду — строки и f-строки
// @ на нижнем ряду (дополнительно к верхнему) — декораторы
            bindings = <
   &kp TILDE  &kp EXCL   &kp AT    &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp ASTRK  &kp LPAR   &kp RPAR   &kp DEL
   &trans     &kp GRAVE  &kp LBRC  &kp RBRC  &kp LBKT  &kp RBKT     &kp UNDER  &kp EQUAL  &kp PLUS   &kp MINUS  &kp COLON  &kp PIPE
   &trans     &trans     &kp BSLH  &kp DQT   &kp SQT   &kp AT       &kp FSLH   &kp QMARK  &kp LT     &kp GT     &kp SEMI   &kp TILDE
                                   &kp LGUI  &trans    &kp SPACE    &kp RET    &mo 3      &kp DEL
            >;
        };

        nav_layer {
// ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬──────╮
// │  `   │  1  │  2  │  3  │  4  │  5  │   │  6  │  7  │  8  │  9  │  0  │ DEL  │
// │ CAPS │HOME │ PgDn│ PgUp│ END │     │   │  ←  │  ↓  │  ↑  │  →  │ F12 │      │
// │      │ F1  │ F2  │ F3  │ F4  │ F5  │   │ F6  │ F7  │ F8  │ F9  │ F10 │ F11  │
// ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┴──────╯
//                    │ GUI │ SYS │ SPC │   │ ENT │ --- │ DEL │
//                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
//
// Стрелки: H/J/K/L (vim-style) — ← ↓ ↑ →
// F12 на home row: быстрый доступ для отладчика/Go to Definition в IDE
            bindings = <
   &kp GRAVE  &kp N1    &kp N2     &kp N3     &kp N4   &kp N5      &kp N6    &kp N7    &kp N8  &kp N9     &kp N0   &kp DEL
   &kp CLCK   &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &trans      &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp F12  &trans
   &trans     &kp F1    &kp F2     &kp F3     &kp F4   &kp F5      &kp F6    &kp F7    &kp F8  &kp F9     &kp F10  &kp F11
                                   &kp LGUI   &mo 3    &kp SPACE   &kp RET   &trans    &kp DEL
            >;
        };

        sys_layer {
// BLE управление (SYM + NAV одновременно)
// ╭──────┬─────┬─────┬─────┬─────┬─────╮   ╭─────┬─────┬─────┬─────┬─────┬──────╮
// │BTCLR │ BT1 │ BT2 │ BT3 │ BT4 │ BT5 │   │     │     │     │     │     │      │
// │      │     │     │     │     │     │   │     │     │     │     │     │      │
// │      │     │     │     │     │     │   │     │     │     │     │     │      │
// ╰──────┴─────┴─────┼─────┼─────┼─────┤   ├─────┼─────┼─────┴─────┴─────┴──────╯
//                    │ GUI │ --- │ SPC │   │ ENT │ --- │ DEL │
//                    ╰─────┴─────┴─────╯   ╰─────┴─────┴─────╯
            bindings = <
   &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
   &trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
   &trans      &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                           &kp LGUI      &trans        &kp SPACE       &kp RET &trans  &kp DEL
            >;
        };
    };
};

/* nice!view использует SPI0; Corne-оверлей включает I2C0 (OLED) после nice_view_adapter,
   поэтому явно отключаем I2C0 последним — keymap-файл идёт последним оверлеем в билде */
&i2c0 {
    status = "disabled";
};
